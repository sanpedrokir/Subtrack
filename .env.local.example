# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Resend API key — get one at https://resend.com/api-keys
RESEND_API_KEY=

# Sender shown on reminder emails. Until you verify a domain in Resend,
# you must use their sandbox sender and can only deliver to the email
# address of the Resend account owner. Verify a domain at
# https://resend.com/domains to send to kirsten_yong@tech.gov.sg and
# wee_wern_chau@tech.gov.sg.
EMAIL_FROM="SubTrack <onboarding@resend.dev>"

# Comma-separated recipient list for expiry reminders.
EMAIL_TO=kirsten_yong@tech.gov.sg,wee_wern_chau@tech.gov.sg

# Currency code used to format costs in the UI and emails.
CURRENCY=SGD

# OpenAI API key for the natural-language query feature ("Ask about your
# subscriptions"). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Neon Postgres connection string (pooled). Get one from your Neon project's
# dashboard at https://console.neon.tech
DATABASE_URL=
